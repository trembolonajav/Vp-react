# Copie para .env e ajuste. NUNCA versione o .env com valores reais.

# ============================================================
# NOVA STACK (backend Spring Boot + PostgreSQL + Docker)
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=vpertz
POSTGRES_USER=vpertz
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# Origem do frontend liberada no CORS (nunca "*" com credenciais).
# No Docker o frontend é servido pelo nginx na mesma origem (sem CORS);
# isto vale para rodar o Vite dev separado.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# URL pública absoluta usada em Open Graph e compartilhamento.
APP_PUBLIC_BASE_URL=http://localhost:8090

# --- Frontend (nginx servindo o SPA + proxy /api /media) ---
FRONTEND_PORT=8090

# --- Autenticação (fase de auth) ---
# JWT_SECRET=defina-um-segredo-longo-com-mais-de-32-caracteres

# --- Storage (fase de uploads: MinIO/S3) ---
STORAGE_TYPE=s3
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ACCESS_KEY=vpertz
STORAGE_S3_SECRET_KEY=troque-esta-senha-minio
STORAGE_S3_BUCKET=vpertz-media
MINIO_ROOT_USER=vpertz
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================
# STACK ATUAL / LEGADA (serverless na Vercel) — ainda no ar
# durante a migração. Remover ao final, na fase de limpeza.
# ============================================================

# Login do painel admin (obrigatório — sem isso o /admin.html não deixa entrar)
ADMIN_USER=vperts
ADMIN_PASS=troque-por-uma-senha-forte

# Assinatura obrigatória do cookie de sessão (mínimo recomendado: 32 caracteres aleatórios)
SESSION_SECRET=troque-por-uma-frase-aleatoria-com-mais-de-32-caracteres

# Vercel Blob — não crie credenciais manualmente.
# Em Storage > Blob, conecte o projeto. Conexões novas usam OIDC e normalmente
# recebem BLOB_STORE_ID; conexões antigas podem usar BLOB_READ_WRITE_TOKEN.
